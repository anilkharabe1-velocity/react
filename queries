// aggregation queries 

db.users.aggregate([{
  $count: 'totalCount'
}])


db.users.aggregate([
  {
    $group:{
      _id: "$gender",
      total: {$sum: 1}
    }
  }
])

db.users.aggregate([
  {
    $group:{
      _id:"$nat",
      totalCount:{$sum: 1}
    }
  },
  {
    $sort:{totalCount: -1}
  },
  {
    $limit: 5
  }
])


db.users.aggregate([
  {
    $group:{
      _id: "$gender",
      avgAge:{
        $avg:"$dob.age"
      }
    }
  }
])

db.users.aggregate([
  {
    $group:{
      _id: null,
      avgAge:{
        $avg:"$dob.age"
      }
    }
  }
])


db.users.aggregate([
  {
    $sort: {"dob.age": -1}
  },
  {
    $limit: 5
  },
  {
    $project:{
      fullName:{
        $concat:["$name.first"," ",  "$name.last"]
      },
      fname: "$name.first",
      lname: "$name.last",
      age: "$dob.age",
      nationality: "$nat"
    }
  }
])


db.users.aggregate([
  {
    $sort: {"dob.age": -1}
  },
  {
    $skip:100
  },
  {
    $limit: 5
  },
  {
    $project:{
      fullName:{
        $concat:["$name.first"," ",  "$name.last"]
      },
      fname: "$name.first",
      lname: "$name.last",
      age: "$dob.age",
      nationality: "$nat"
    }
  }
])



